# TransAgent 环境变量示例
# 复制为 .env 并按需填写（.env 已被 gitignore，不会入库）

# ── LLM API（必填）──
# 主力模型 DeepSeek（默认 deepseek-v4-flash）
DEEPSEEK_API_KEY=sk-xxxx
# 备选模型 通义千问（可选，主力失败时切换）
QWEN_API_KEY=

# ── 服务 ──
# 后端端口（默认 8000）
TRANSAGENT_PORT=8000

# ── 可选开关 ──
# 演示模式：使用预置 RAG/TM 数据
# TRANSAGENT_DEMO_MODE=true
# 关闭 Web 搜索查证
# TRANSAGENT_WEB_SEARCH_DISABLED=true

# ── 前端构建时注入（Railway/Render 部署时指向后端公网地址）──
# VITE_API_BASE_URL=https://your-backend-domain.up.railway.app
# VITE_USE_MOCK=true   # 纯前端 Mock 模式（无需后端）
